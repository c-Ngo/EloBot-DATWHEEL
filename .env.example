# Discord Bot Token — from https://discord.com/developers/applications
DISCORD_TOKEN=

# Discord Application ID — from the same developer portal
CLIENT_ID=

# (Optional) Guild ID for instant slash command updates during development
GUILD_ID=

# (Optional) Riot Games API Key — only needed if you want to verify Riot accounts during /link
# Custom game stats are parsed directly from .rofl replay files, so no API key is required!
RIOT_API_KEY=

# Default Riot region cluster (optional)
RIOT_REGION=europe

# Default platform (optional)
RIOT_PLATFORM=euw1

# Starting Elo for newly linked players
DEFAULT_ELO=1000

# Elo K-factor base (higher = more volatile ratings)
K_FACTOR=32
